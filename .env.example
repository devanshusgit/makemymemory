# ─────────────────────────────────────────────────────────────────────────────
# Make My Memory — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Every name below is actually read by the code (grep for `process.env.`).
# Placeholder values only — never paste a real secret into this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# required — used in email links and by scripts/seed-categories.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# required — get a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/make-my-memory?retryWrites=true&w=majority

# ── Admin ─────────────────────────────────────────────────────────────────────
# required — ADMIN_PASSWORD doubles as the admin_session cookie value
ADMIN_PASSWORD=your_admin_password
# required — recipient for admin notification emails
ADMIN_EMAIL=admin@makemymemory.in

# ── Internal API secret (for PATCH /api/orders/[id]) ─────────────────────────
# required — generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your_random_secret_here
# required — signs the customer login cookie (any long random string).
# Falls back to ADMIN_PASSWORD when unset; changing either logs everyone out.
SESSION_SECRET=your_long_random_session_secret

# ── Payments (Razorpay: online + COD advance) ────────────────────────────────
# Get API keys from https://dashboard.razorpay.com
# Use matching test keys for development; live keys for production.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Same value as RAZORPAY_KEY_ID; only the key ID is intentionally public.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# Set the same secret in the Razorpay webhook configuration and here.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get from: https://resend.com
RESEND_API_KEY=your_resend_api_key
# required — verified sender address for Resend
EMAIL_FROM=noreply@makemymemory.in

# ── Email: SMTP (OTP, order updates, account alerts) ─────────────────────────
# Set SMTP_HOST *and* SMTP_PORT to use SMTP; if either is unset the code falls
# back to the Gmail block below.
# optional — required only if you are not using the Gmail fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# optional — "true" forces an implicit-TLS connection (port 465)
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# optional — From: header for SMTP mail; falls back to GMAIL_USER when unset
SMTP_FROM=noreply@makemymemory.in

# ── Email: Gmail fallback ─────────────────────────────────────────────────────
# optional — used only when SMTP_HOST/SMTP_PORT are not both set
GMAIL_USER=your_gmail_address@gmail.com
# optional — a Google App Password, not your account password
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── SMS / OTP (Twilio) ────────────────────────────────────────────────────────
# optional — SMS OTP is skipped entirely when SID or auth token is unset
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# optional — required if the two above are set; E.164 format
TWILIO_PHONE_NUMBER=+10000000000

# ── Uploads (Cloudinary) ──────────────────────────────────────────────────────
# required for /api/upload — get from https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Analytics & Search Console (all optional — leave unset to disable) ────────
# Google Tag Manager container ID (e.g. GTM-XXXXXXX) from tagmanager.google.com.
# Manage GA4 + Meta Pixel + any future tag from inside GTM once this is set —
# no further code changes needed to add/change tags later.
NEXT_PUBLIC_GTM_ID=
# Google Search Console → Settings → Ownership verification → HTML tag method
# → copy just the content="..." value (not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Feature flags ─────────────────────────────────────────────────────────────
# optional — "true" emails every user when a new product is published
NOTIFY_USERS_NEW_PRODUCTS=false

# ── Social links ──────────────────────────────────────────────────────────────
# optional — falls back to https://instagram.com/makemymemory when unset
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your_handle

# required — shared token for the Delhivery status webhook
DELHIVERY_WEBHOOK_SECRET=your_random_webhook_token

# ── Google reviews (optional — the /reviews Google section hides when unset) ──
# Reviews left on the Google Business Profile appear on /reviews automatically.
# 1. Google Cloud console → enable "Places API (New)" → create an API key.
# 2. Restrict the key to the Places API.
# 3. Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
